# Copy this file to .env and paste your own Alpaca PAPER keys.
# Get them at https://app.alpaca.markets  ->  Paper Trading  ->  API Keys.
# Never share the real file. It is ignored by git.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional: Telegram updates. Create a bot with @BotFather, paste its token, then run
#   python scripts/telegram_setup.py   (fills in the chat id after you message the bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
