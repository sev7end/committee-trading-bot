{
  "timeframe": "1Day",
  "data_provider": "yfinance",
  "benchmark": "SPY",
  "data_start": "2014-08-03",
  "windows": {
    "train": {
      "start": "2015-10-27",
      "end": "2025-10-27"
    },
    "holdout": {
      "start": "2025-10-28",
      "end": "2026-10-26"
    }
  },
  "warmup_bars": 60,
  "account": {
    "starting_cash": 25000,
    "max_positions": 8,
    "max_per_sector": 0
  },
  "costs": {
    "spread_bps": 3,
    "slippage_bps": 5,
    "commission_per_share": 0.0,
    "min_commission": 0.0,
    "sell_fee_bps": 0.3
  },
  "loop": {
    "min_trades": 300,
    "min_improvement_pct": 1.0,
    "claude_cmd": "claude",
    "max_turns": 40,
    "model": null
  },
  "validation_universe": [
    "SPY",
    "QQQ",
    "IWM",
    "DIA",
    "XLK",
    "XLF",
    "XLV",
    "XLE",
    "XLY",
    "XLP",
    "XLI",
    "XLB",
    "XLU",
    "XLRE",
    "XLC"
  ],
  "sweep": {
    "min_trades": 300,
    "min_positive_years_pct": 70,
    "workers": 0,
    "plateau_top_k": 8,
    "memo_entries": 5000
  },
  "paper": {
    "equity_cap": 25000,
    "entry_orders": {
      "type": "marketable_limit",
      "buffer_bps": 20,
      "wait_seconds": 120,
      "fallback_to_market": true
    },
    "min_position_notional": 250
  },
  "autopilot": {
    "embargo_days": 365,
    "train_years": 10,
    "retune_every_days": 28,
    "sweep_samples": 800,
    "replace_margin": 1.15,
    "claude_rounds_on_stall": 3,
    "kill_switch": {
      "max_drawdown_pct": 10,
      "min_trades": 30,
      "min_profit_factor": 0.8,
      "resume_after_days": 28
    },
    "calibrate_costs": {
      "enabled": true,
      "min_fills": 30,
      "min_bps": 2,
      "max_bps": 30
    },
    "holdout_start_offsets_days": [
      0,
      14,
      42
    ],
    "history_days_before_train": 450
  },
  "books": [
    {
      "name": "trend",
      "params": "config/params.json",
      "capital_pct": 40,
      "space": "trend",
      "universe": "stocks",
      "enabled": true,
      "seed": "config/params_seed_trend.json",
      "_comment": "committee space with the chop filter (walk-forward: 6/8 years, median OOS PF 1.30); seeded from the neutral file"
    },
    {
      "name": "mr",
      "params": "config/params_mr.json",
      "capital_pct": 10,
      "space": "mr",
      "universe": "etf",
      "enabled": true,
      "_comment": "paper experiment: mean reversion on the ETF set, judged monthly by the autopilot on forward data"
    },
    {
      "name": "xa",
      "params": "config/params_xa.json",
      "capital_pct": 20,
      "space": "xa",
      "universe": "xa",
      "secondary": "etf",
      "enabled": true,
      "_comment": "cross-asset trend following; enabled 2026-09-18 after sweep + holdout; lowers account drawdown ~30% in combination"
    },
    {
      "name": "rotation",
      "engine": "rotation",
      "params": "config/params_rotation.json",
      "capital_pct": 30,
      "universe": "rotation_stocks",
      "secondary": "stocks2016",
      "disaster_stop_pct": 20,
      "enabled": true,
      "_comment": "monthly momentum rotation (top 8 by 12-month return, vol-weighted, positive momentum only). Walk-forward 2018-2025 on the 2016-era universe: 7/8 years, 19.6%/yr vs SPY 15.5%; holdout +18-20% vs SPY +13% at 3 starts. No targets/time exits; a 20% disaster stop per position; rebalances on the first session of each month."
    },
    {
      "name": "crypto",
      "params": "config/params_crypto.json",
      "seed": "config/params_seed_crypto.json",
      "capital_pct": 0,
      "space": "crypto",
      "universe": "crypto",
      "secondary": "crypto_alt",
      "benchmark": "BTC-USD",
      "costs": {
        "spread_bps": 10,
        "slippage_bps": 10,
        "fee_bps": 25
      },
      "fractional": true,
      "schedule": "daily_utc",
      "enabled": false,
      "_comment": "research only until it passes the gates: 24/7 majors vs the 2020+ alts as the bias check, BTC as the regime benchmark, Alpaca crypto fees",
      "watch": true
    },
    {
      "name": "crypto_mr",
      "params": "config/params_crypto_mr.json",
      "seed": "config/params_seed_crypto_mr.json",
      "capital_pct": 0,
      "space": "crypto_mr",
      "universe": "crypto_single",
      "secondary": "crypto",
      "benchmark": "BTC-USD",
      "costs": {
        "spread_bps": 10,
        "slippage_bps": 10,
        "fee_bps": 25
      },
      "fractional": true,
      "schedule": "daily_utc",
      "min_trades": 120,
      "enabled": false,
      "_comment": "research only: dip-buying in BTC/ETH uptrends; the other majors are the bias check",
      "watch": true
    }
  ],
